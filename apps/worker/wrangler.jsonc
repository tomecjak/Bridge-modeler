// Cloudflare Worker modelára mostov (ADR 0015). Postup nastavenia účtu: docs/nasadenie.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modeler-mostov",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  // aplikácia beží na <name>.<účet>.workers.dev; náhľadové URL verzií sú vypnuté, aby neobchádzali Access
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker beží len pre API; statické súbory obslúži Cloudflare priamo (Access chráni oboje)
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "modeler-mostov",
      // doplní sa po `wrangler d1 create modeler-mostov` (docs/nasadenie.md); lokálny vývoj funguje aj bez neho
      "database_id": "a90e2ad0-9ef6-4278-9699-ed0018a07670",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // tím Cloudflare Access (napr. "firma.cloudflareaccess.com") a AUD aplikácie Access; prázdne = lokálny vývoj
    "ACCESS_TEAM_DOMAIN": "kubator-pages.cloudflareaccess.com",
    "ACCESS_AUD": "d1d940116b09f034e85eeeda3a95f5a977d8da70ed886bd1b0b77a55e25c87fa"
  },
  "observability": { "enabled": true }
}
